{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"paths": {"vue-component-catalog/define": ["./src/define.ts"]},
		"types": ["node", "vite/client"]
	},
	"include": ["src", "test", "playground", "client.d.ts"]
}
